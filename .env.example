# このファイルを.envにコピーし、HOSTED_ZONE_IDとRECORD_NAMEを設定してください。
# GNU Makeの変数定義として読み込むため、値をクォートで囲む必要はありません。

# AWS CLIのプロファイル名。空欄の場合は既定の認証設定を使います。
AWS_PROFILE=
REGION=ap-northeast-1
STACK_NAME=ixddns-ipv4

# 既存のRoute 53パブリックホストゾーンID。例: Z0123456789EXAMPLE
HOSTED_ZONE_ID=
# 更新するDNS名。小文字で、末尾のドットは付けません。例: router.example.com
RECORD_NAME=
RECORD_TYPE=A
RECORD_TTL=60
LOG_RETENTION_DAYS=30

# false: 制限なし。true: 下記方式で送信元を制限（共有トークン認証は常に必要）。
ASN_RESTRICTION_ENABLED=false

# static: デプロイ時にASNの起点CIDRを取得しLambdaへ埋め込み。WAF固定料金なし（推奨）。
# waf: REST API＋AWS WAFのASN判定。現構成は約7 USD/月/スタック＋WAFリクエスト料金。
# どちらもAPI・Lambda・Secrets Manager・ログ・Route 53等の通常料金は別途発生します。
# wafへ／wafから切り替えるとURLが変わります。make ix-configで再生成してください。
ASN_RESTRICTION_METHOD=static

# trueの場合は実回線のASNをカンマ区切りで指定します。AS接頭辞を付けず、ASN 0は指定しません。
# 例: 64496,64500（説明用の番号なので、実際のASNに変更してください）
ALLOWED_ASNS=

# staticは毎回ビルド時にRIPEstatへ取得。経路変更に追従するには定期的にmake deploy。
# 空欄を推奨。必要なら取得済みasn-prefixes.jsonを指定（同じASN、取得・観測から48時間以内）。
# 取得失敗時に古い一覧へ自動フォールバックしません。詳細と料金内訳はREADME参照。
ASN_PREFIXES_FILE=

# make ix-configで投入用コンフィグを生成します。
# Aレコード: 登録するグローバルIPv4を持つ実機のインタフェース名。
# 例: GigaEthernet0.1（実際の接続方式と設定に合わせて指定してください）
IX_WAN_IF=
# AAAAレコード: HTTPSのIPv4送信元と、通知するIPv6を持つインタフェース名。
IX_SOURCE_IF=
IX_NOTIFY_IF=
# 空欄の場合、examples/ix3315-ddns-ipv4.cfgまたはipv6.cfgに保存します。
# 生成ファイルには共有トークンが含まれます。Git除外対象の保存先を使ってください。
IX_CONFIG_OUTPUT=
